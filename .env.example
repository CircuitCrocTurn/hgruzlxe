# Copy to .env and fill in.

# Required for /auth/request-code (SMS via hh.ru → 2captcha solves the captcha).
# Get one at https://2captcha.com/. Without this, the endpoint returns 500
# twocaptcha_key_not_configured.
TWOCAPTCHA_KEY=

# Server-side session cookie signing secret. Generate something random:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Set to 1 to enable verbose logs.
# OFFERDAY_DEBUG=1

# PostgreSQL setup
DATABASE_URL=postgresql+asyncpg://login:pass@localhost:5432/offerday

# Used by app/db/session.py to gate echo of SQL statements.
APP_ENV=development

